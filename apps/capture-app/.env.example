# apps/capture-app — environment contract
# Copy to apps/capture-app/.env.local and fill locally. NEVER commit real values.
# EXPO_PUBLIC_* is inlined into the app binary and readable on a jailbroken device.
# A secret with an EXPO_PUBLIC_ prefix is a LEAKED secret (ENVIRONMENT.md §2).
# Only the values below are client-safe.

EXPO_PUBLIC_SUPABASE_URL=              # public: Supabase project URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=         # public: anon key (RLS-bound)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=     # public: Cloudinary cloud name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=  # public: unsigned preset (verified_capture)
EXPO_PUBLIC_API_URL=                   # config: base URL of the @impact/api service
EXPO_PUBLIC_ORG_ID=                    # config: org id used only as a public_id path component (§3.4); the API re-derives org from the verified JWT
