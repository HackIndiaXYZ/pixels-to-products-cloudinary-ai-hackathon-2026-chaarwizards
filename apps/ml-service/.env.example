# apps/ml-service — environment contract
# Copy to apps/ml-service/.env.local and fill locally. NEVER commit real values.
# Server-only service. No VITE_/EXPO_PUBLIC_ prefixes (ENVIRONMENT.md §2).

SUPABASE_URL=          # public: Supabase project URL
SUPABASE_SERVICE_KEY=  # 🔴 SECRET: service-role key. Server-only.
CLOUDINARY_CLOUD_NAME= # public: Cloudinary cloud name
CLOUDINARY_API_KEY=    # semi-public: API key (download assets, upload diffs)
CLOUDINARY_API_SECRET= # 🔴 SECRET: API secret. Server-only. Never in a client bundle.
INTERNAL_JWT_SECRET=   # 🔴 SECRET: HS256 secret. Byte-identical to @panchnama/api or every call 401s.
WEIGHTS_DIR=           # config: path to model weights (gitignored, downloaded at build)
