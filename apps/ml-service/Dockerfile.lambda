# apps/ml-service — ML service image for AWS Lambda (container image).
# Uses public ECR image with Lambda Web Adapter pre-installed (Amazon Linux 2023 base).
FROM public.ecr.aws/awsguru/aws-lambda-adapter:1.0.1

WORKDIR /app

# System deps for Amazon Linux 2023 (dnf):
# - OpenCV runtime libs for opencv-python-headless.
# - ffmpeg for the video keyframe-extraction pipeline (Phase 6).
# Use exec form since base image lacks /bin/sh (only /bin/bash)
RUN ["/bin/bash", "-c", "dnf install -y glib2 libSM libXext libXrender mesa-libGL ffmpeg && dnf clean all"]

# Python deps first for layer caching. Install the CPU-only torch wheel from the
# PyTorch CPU index (Lambda is CPU — this avoids pulling ~2 GB of CUDA libraries
# and roughly halves the image), then the rest from PyPI.
COPY requirements.txt requirements-ml.txt ./
RUN ["/bin/bash", "-c", "pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r requirements.txt -r requirements-ml.txt"]

# App code + the learned ONNX weights.
COPY src/ ./src/
COPY weights/ ./weights/

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    WEIGHTS_DIR=/app/weights \
    # Lambda Web Adapter config (already installed in base image)
    AWS_LWA_PORT=8080 \
    AWS_LWA_INVOKE_MODE=RESPONSE_STREAM \
    AWS_LWA_READINESS_CHECK_PATH=/health

EXPOSE 8080

# The adapter (in base image) wraps this CMD.
# uvicorn must listen on the same port as AWS_LWA_PORT (8080).
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]