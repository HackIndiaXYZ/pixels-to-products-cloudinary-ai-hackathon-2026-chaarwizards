# apps/dashboard — environment contract
# Copy to apps/dashboard/.env.local and fill locally. NEVER commit real values.
# EVERY VITE_* var is inlined into the client JS bundle and is publicly readable
# (ENVIRONMENT.md §2). Only client-safe values may live here.
# NEVER add the Cloudinary API secret or the Supabase service-role key with a VITE_ prefix.

VITE_CLOUDINARY_CLOUD_NAME=     # public: Cloudinary cloud name
VITE_CLOUDINARY_UPLOAD_PRESET=  # public: unsigned preset (verified_capture)
VITE_SUPABASE_URL=              # public: Supabase project URL
VITE_SUPABASE_ANON_KEY=         # public: anon key (RLS-bound)
VITE_API_URL=                   # config: base URL of the @impact/api service
