{
  "name": "@panchnama/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run src/routes/search-perf.integration.test.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:docs:endpoints": "tsx scripts/check-docs.ts --endpoints-only",
    "dev": "tsx watch src/start.ts",
    "start": "node dist/start.js",
    "reconcile": "node dist/jobs/reconcile.js",
    "setup:preset": "node dist/jobs/setup-preset.js",
    "workers": "node dist/jobs/workers.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.2.1",
    "@panchnama/shared": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "bullmq": "^5.34.5",
    "cloudinary": "^2.5.1",
    "decimal.js": "^10.6.0",
    "fastify": "^5.2.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "puppeteer": "^25.12.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "2.1.9",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
