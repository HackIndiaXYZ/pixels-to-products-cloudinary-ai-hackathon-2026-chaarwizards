# apps/api — environment contract
# Copy to apps/api/.env.local and fill locally. NEVER commit real values.
# Exposure classes per ENVIRONMENT.md §2. Server-only file: no VITE_/EXPO_PUBLIC_ prefixes here.

# --- Runtime ---
NODE_ENV=              # development | production | test
HOST=                  # bind address, e.g. 0.0.0.0
PORT=                  # HTTP port, e.g. 8080
LOG_LEVEL=             # pino level: fatal|error|warn|info|debug|trace

# --- Supabase (system of record) ---
SUPABASE_URL=          # public: project URL
SUPABASE_ANON_KEY=     # public: anon key (RLS-bound)
SUPABASE_SERVICE_KEY=  # 🔴 SECRET: service-role key. Workers only. Never a VITE_/EXPO_PUBLIC_ var.

# --- Cloudinary (media pipeline, never a query DB) ---
CLOUDINARY_CLOUD_NAME=     # public: cloud name
CLOUDINARY_API_KEY=        # semi-public: API key
CLOUDINARY_API_SECRET=     # 🔴 SECRET: API secret. Server-only. Never reaches a client bundle.
CLOUDINARY_UPLOAD_PRESET=  # public: unsigned preset name (verified_capture)

# --- Internal service auth ---
INTERNAL_JWT_SECRET=   # 🔴 SECRET: HS256 secret for the 120s API->ML token. Byte-identical to ml-service.

# --- Infra / config ---
REDIS_URL=             # 🔴 SECRET: BullMQ / Redis connection URL
ML_SERVICE_URL=        # config: base URL of the ML service
DASHBOARD_URL=         # config: CORS origin + invite_url base. Unset => invites point at localhost:5173.
