# Keep the EAS build archive small. None of this is needed to build the
# capture app, and some of it is multi-GB (ML venv/datasets/weights), which
# otherwise overflows a small /tmp during tarball creation.
apps/ml-service/
supabase/
docs/
brag/
scratch/
*.zip
*.onnx
*.onnx.data

# Native build intermediates — regenerated by EAS on a clean build, and they
# carry stale generated sources (e.g. old applicationId). Exclude so the archive
# is lean and never ships stale generated manifests.
apps/capture-app/android/build/
apps/capture-app/android/.gradle/
apps/capture-app/android/app/build/
apps/capture-app/ios/build/
apps/capture-app/ios/Pods/
