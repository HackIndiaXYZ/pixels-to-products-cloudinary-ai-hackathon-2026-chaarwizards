# coverage output (Phase 11 — thresholds enforced in CI, reports not committed)
coverage/
.coverage
coverage-summary.json

# ml artifacts
*.pt
*.pth
*.onnx
*.engine
weights/
*.weights

# …but DO ship the ML runtime weights — the Render image bakes them in, so they
# must be tracked despite the generic ignores above (order matters: these win).
!apps/ml-service/weights/
!apps/ml-service/weights/*.onnx
!apps/ml-service/weights/*.onnx.data
!apps/ml-service/weights/*.pt

# training archives (uploaded for local wiring) + Windows/WSL download metadata
*.zip
*.tar.gz
*:Zone.Identifier

# local — never commit
.DS_Store
*.log
.agents/*
skills-lock.json

# Phase 8 E2E local seed output (contains a local test password; regenerated by e2e-seed.ts)
apps/api/e2e-scripts/.e2e-seed.json
# Playwright artifacts
apps/dashboard/test-results/
apps/dashboard/playwright-report/

brag/
docs/diagrams
